{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "machibun-website",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "machibun",
			"database_id": "c7349d56-5024-47bc-b3aa-905af1664633",
		},
	],
	"kv_namespaces": [
		{ "binding": "MEDIA", "id": "8c115efcc8d74942b5be5e9275f88366" },
		{ "binding": "SESSION", "id": "d9219de9ab9f4f74af67822991ce1aca" },
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "machibun-preview",
				"database_id": "9af2f4b3-ccc7-41f6-892b-50434720730d",
			},
		],
		"kv_namespaces": [
			{ "binding": "MEDIA", "id": "2ae641097d0d449589fce79a71056d81" },
			{ "binding": "SESSION", "id": "346f84bf0a62489db258a863451895ae" },
		],
	},
}
