{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "machibun2026",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "machibun2026",
			"database_id": "4dff514e-9f3f-4ddf-a2d7-273fbce121bc",
		},
	],
	"kv_namespaces": [
		{ "binding": "MEDIA", "id": "8c115efcc8d74942b5be5e9275f88366" },
		{ "binding": "SESSION", "id": "d9219de9ab9f4f74af67822991ce1aca" },
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
	"env": {
		"staging": {
			"name": "machibun2026-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "machibun2026-staging",
					"database_id": "238b67c7-ab67-4305-b6ea-f0f285c2f704",
				},
			],
			"kv_namespaces": [
				{ "binding": "MEDIA", "id": "2ae641097d0d449589fce79a71056d81" },
				{ "binding": "SESSION", "id": "346f84bf0a62489db258a863451895ae" },
			],
		},
	},
}
